# Copy to backend/.env and fill the provider keys you want to use.
# Existing process environment values take precedence over .env values.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional model names and OpenAI-compatible base URLs.
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-3.8-flash
# DEEPSEEK_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional bootstrap password for the first admin account (at least 16 characters).
# SA_SEED_ADMIN_PASSWORD is also accepted; NX_SEED_ADMIN_PASSWORD takes precedence.
# If omitted, the migration command generates and prints a one-time password.
# NX_SEED_ADMIN_PASSWORD=
# SA_SEED_ADMIN_PASSWORD=

# Optional backend configuration overrides use NX_ and double underscores.
# NX_HTTP__PORT=8080
# NX_LLM__DEFAULT_CHAT=gemini-default
